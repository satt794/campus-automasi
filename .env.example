# ==============================================================================
# CAMPUS AUTOMASI - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi '.env.local' untuk penggunaan lokal:
# cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Dapatkan di: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci anon/public untuk pemanggilan di sisi frontend (Client Component)
# Dapatkan di: Supabase Dashboard > Project Settings > API > Project API keys (anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Kunci rahasia service role untuk API Route & Cron Job (JANGAN PERNAH diekspos ke frontend!)
# Dapatkan di: Supabase Dashboard > Project Settings > API > Project API keys (service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# TELEGRAM BOT INTEGRATION
# ------------------------------------------------------------------------------
# Dapatkan dengan membuat bot baru melalui @BotFather di Telegram (perintah /newbot)
# Format contoh: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------------------------
# VERCEL CRON SECURITY
# ------------------------------------------------------------------------------
# Kunci rahasia untuk memvalidasi bahwa request API Cron benar-benar berasal dari Vercel
# Anda bisa membuat string acak yang aman melalui terminal: openssl rand -hex 32
CRON_SECRET=your_generated_random_cron_secret_string
